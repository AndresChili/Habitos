# Provisioned automatically by the Neon integration (`vercel integration add neon`)
# and pulled with `vercel env pull .env.local`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Set manually: secret used to sign the session cookie. Any user who knows
# this value can forge sessions, so keep it out of git and rotate it if it
# ever leaks (rotating invalidates every active session). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

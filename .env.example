# Provisioned automatically by the Neon integration (`vercel integration add neon`)
# and pulled with `vercel env pull .env.local`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Set manually: passcode used to log into the app, and the secret used to sign
# the session cookie. Generate SESSION_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PASSCODE=
SESSION_SECRET=

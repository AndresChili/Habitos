generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecurrenceType {
  FIXED_DAYS
  QUOTA
}

enum QuotaPeriod {
  WEEK
  MONTH
}

enum BreakReason {
  VACATION
  SICK
  OTHER
}

// Una cuenta por persona. Todo lo demás cuelga de userId para que cualquier
// consulta pueda limitarse a "solo lo que pertenece a este usuario" — ver src/lib/dal.ts.
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  // Se incrementa al cerrar sesión o cambiar la contraseña — invalida de golpe
  // cualquier cookie de sesión ya emitida (robada o no) aunque siga sin caducar.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())

  habits     Habit[]
  habitLogs  HabitLog[]
  pauses     HabitPause[]
  breaks     Break[]
  tasks      Task[]
  weightLogs WeightLog[]
  settings   Settings?

  exercises        Exercise[]
  routines         Routine[]
  routineExercises RoutineExercise[]
  workoutSessions  WorkoutSession[]
  workoutExercises WorkoutExercise[]
  setEntries       SetEntry[]
}

// Intentos de login/registro, fallidos o correctos, indexados por el email
// enviado — no es una FK a User, para poder limitar intentos contra emails
// que todavía no existen sin filtrar esa distinción por tiempo o errores.
// También se indexa por ip para frenar a quien prueba una misma contraseña
// contra muchos emails distintos, cosa que un límite solo por email no detecta.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String   @default("unknown")
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Los hábitos FIXED_DAYS vencen en días concretos de la semana (1=lunes..7=domingo,
// ISO) — se marcan desde "Hoy". Los QUOTA solo necesitan N cumplimientos dentro
// del periodo, en cualquier día; se marcan desde "Hábitos" porque no tienen un
// único día de vencimiento.
model Habit {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  recurrenceType RecurrenceType
  weekdays       Int[]           @default([])
  quotaPeriod    QuotaPeriod?
  quotaTarget    Int?
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  logs           HabitLog[]
  pauses         HabitPause[]

  @@index([userId, archivedAt])
}

// Un hábito se puede pausar/reanudar repetidamente; cada periodo se registra
// para que los días pasados sigan marcados correctamente como "no programado"
// incluso después de reanudar. toDate null = pausa todavía activa. userId está
// desnormalizado desde Habit para que cualquier consulta pueda filtrar por
// propietario directamente, sin join, como segunda línea de defensa frente a
// accesos entre usuarios.
model HabitPause {
  id       String   @id @default(cuid())
  habitId  String
  habit    Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDate String
  toDate   String?

  @@index([habitId])
  @@index([userId])
}

// Pausa global de cuenta (vacaciones, enfermedad, etc.) — a diferencia de
// HabitPause, no cuelga de un hábito concreto: cubre hábitos y gimnasio a la
// vez durante el rango de fechas. toDate null = todavía en curso (no se sabe
// cuándo termina, ej. un "estoy malo" que empieza hoy).
model Break {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDate  String
  toDate    String?
  reason    BreakReason @default(OTHER)
  note      String?
  createdAt DateTime    @default(now())

  @@index([userId, fromDate])
}

// date es "YYYY-MM-DD" en la zona horaria de la app — evita errores de DST/
// límites UTC, ya que solo se comparan días de calendario, nunca instantes.
// Una fila por fecha de cumplimiento, sin importar el tipo de hábito
// (FIXED_DAYS o QUOTA). userId está desnormalizado desde Habit, mismo
// motivo que en HabitPause.
model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId])
  @@index([userId])
}

model Task {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  title     String
  time      String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// Una entrada por día, introducida desde "Hoy", mostrada con histórico/gráfica en "Peso".
model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  weightKg  Float
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

// Una fila por usuario. gymWeekdays usa la misma codificación ISO de día de
// semana que Habit.weekdays (1=lunes..7=domingo) — qué días entrena el
// usuario en general, independientemente de qué rutina toque cada uno de
// esos días (ver Routine.weekdays).
model Settings {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone     String @default("Europe/Madrid")
  gymWeekdays  Int[]  @default([])
}

// ---- Gimnasio ----

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FEMORAL
  CUADRICEPS
  GLUTES
  ABDOMINALES
  GEMELOS
  ABDUCTORES
}

enum Equipment {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
}

enum SetType {
  WARMUP
  NORMAL
  TOP_SET
  BACK_OFF
}

enum WorkoutStatus {
  IN_PROGRESS
  COMPLETED
}

// Cada ejercicio lo crea un usuario — no hay biblioteca predefinida/global.
// Los ejercicios solo se archivan, nunca se borran de verdad — RoutineExercise
// y WorkoutExercise referencian Exercise con onDelete: Restrict como red de
// seguridad, así las series históricas nunca pueden quedar huérfanas por un borrado.
model Exercise {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  primaryMuscle    MuscleGroup
  secondaryMuscles MuscleGroup[] @default([])
  equipment        Equipment     @default(BARBELL)
  instructions     String?
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())

  routineExercises RoutineExercise[]
  workoutExercises WorkoutExercise[]

  @@index([userId, archivedAt])
}

// Una plantilla reutilizable. Borrar/editar una rutina nunca afecta a los
// WorkoutSession pasados — estos tienen sus propias filas WorkoutExercise/
// SetEntry que no referencian RoutineExercise en absoluto (ver WorkoutSession
// más abajo). weekdays: qué día(s) usa esta rutina (1=lunes..7=domingo, misma
// codificación que Habit.weekdays). Se fuerza en el código de la aplicación
// que sea exclusivo — asignar un día a una rutina se lo quita a cualquier otra.
model Routine {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  weekdays    Int[]     @default([])
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  exercises       RoutineExercise[]
  workoutSessions WorkoutSession[]

  @@index([userId, archivedAt])
}

// Un ejercicio colocado dentro de una rutina, con orden. targetRepMin/Max es
// opcional y va aquí (no en Exercise) porque el mismo ejercicio puede tener
// un objetivo de repeticiones distinto en cada rutina.
model RoutineExercise {
  id           String   @id @default(cuid())
  routineId    String
  routine      Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order        Int
  targetRepMin Int?
  targetRepMax Int?

  @@index([routineId, order])
  @@index([userId])
}

// Un entrenamiento real. routineName es una foto fija tomada al crearse para
// que el historial se siga leyendo bien aunque la rutina se renombre o se
// borre después (routineId pasa a null, routineName se queda). Se crea en el
// momento en que el usuario pulsa "Empezar" (status IN_PROGRESS) para que el
// progreso sea duradero desde la primera serie, no solo en memoria del cliente.
model WorkoutSession {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId   String?
  routine     Routine?      @relation(fields: [routineId], references: [id], onDelete: SetNull)
  routineName String
  // "YYYY-MM-DD" en la zona horaria del usuario al crearse — misma convención
  // dayKey que Habit/Task, usada para responder "ya hay una sesión de esta
  // rutina hoy" sin consultas por rango de instantes sensibles al huso horario.
  dateKey     String
  status      WorkoutStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  finishedAt  DateTime?

  exercises WorkoutExercise[]

  @@index([userId, startedAt])
  @@index([userId, routineId, dateKey])
}

// Un ejercicio tal como se realizó de verdad dentro de una sesión. Referencia
// Exercise directamente (no RoutineExercise) para que sobreviva a cualquier
// edición posterior de la rutina de la que vino.
model WorkoutExercise {
  id               String         @id @default(cuid())
  workoutSessionId String
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order            Int
  notes            String?

  sets SetEntry[]

  @@index([workoutSessionId, order])
  @@index([userId, exerciseId])
}

model SetEntry {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  order             Int
  weightKg          Float
  reps              Int
  setType           SetType         @default(NORMAL)
  isPr              Boolean         @default(false)
  createdAt         DateTime        @default(now())

  @@index([workoutExerciseId, order])
  @@index([userId])
}

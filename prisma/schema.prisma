generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecurrenceType {
  FIXED_DAYS
  QUOTA
}

enum QuotaPeriod {
  WEEK
  MONTH
}

// FIXED_DAYS habits are due on specific weekdays (1=Monday..7=Sunday, ISO) —
// checked off from "Hoy". QUOTA habits just need N completions within the
// period, any days; checked off from "Hábitos" since there's no single "due" day.
model Habit {
  id             String          @id @default(cuid())
  name           String
  recurrenceType RecurrenceType
  weekdays       Int[]           @default([])
  quotaPeriod    QuotaPeriod?
  quotaTarget    Int?
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  logs           HabitLog[]
  pauses         HabitPause[]

  @@index([archivedAt])
}

// A habit can be paused/resumed repeatedly; each window is recorded so past
// calendar days stay correctly marked "not scheduled" even after resuming.
// toDate null = pause still active.
model HabitPause {
  id       String   @id @default(cuid())
  habitId  String
  habit    Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  fromDate String
  toDate   String?

  @@index([habitId])
}

// date is "YYYY-MM-DD" in the app timezone — avoids DST/UTC-boundary bugs,
// since we only ever compare calendar days, not instants. One row per
// completion date regardless of habit type (FIXED_DAYS or QUOTA).
model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId])
}

model Task {
  id        String   @id @default(cuid())
  date      String
  title     String
  time      String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([date])
}

// One entry per day, entered from "Hoy", surfaced with history/graph on "Peso".
model WeightLog {
  id        String   @id @default(cuid())
  date      String   @unique
  weightKg  Float
  createdAt DateTime @default(now())
}

// Singleton row (id always 1).
model Settings {
  id       Int    @id @default(1)
  timezone String @default("Europe/Madrid")
}

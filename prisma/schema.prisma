generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
}

model Habit {
  id        String     @id @default(cuid())
  name      String
  frequency Frequency
  archived  Boolean    @default(false)
  createdAt DateTime   @default(now())
  logs      HabitLog[]

  @@index([frequency, archived])
}

// date is "YYYY-MM-DD" in the app timezone — avoids DST/UTC-boundary bugs,
// since we only ever compare calendar days, not instants.
model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId])
}

// Singleton row (id always 1) holding slot caps and unlock-evaluation cursors.
model Settings {
  id                     Int      @id @default(1)
  timezone               String   @default("Europe/Madrid")
  dailyCap               Int      @default(3)
  weeklyCap              Int      @default(2)
  monthlyCap             Int      @default(6)
  lastDailyUnlockWeek    String?
  lastWeeklyUnlockMonth  String?
}

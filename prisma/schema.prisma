generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecurrenceType {
  FIXED_DAYS
  QUOTA
}

enum QuotaPeriod {
  WEEK
  MONTH
}

// One account per person. All other data hangs off userId so every query can
// be scoped to "only what this user owns" — see src/lib/dal.ts.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  habits     Habit[]
  habitLogs  HabitLog[]
  pauses     HabitPause[]
  tasks      Task[]
  weightLogs WeightLog[]
  settings   Settings?

  exercises        Exercise[]
  routines         Routine[]
  routineExercises RoutineExercise[]
  workoutSessions  WorkoutSession[]
  workoutExercises WorkoutExercise[]
  setEntries       SetEntry[]
}

// Failed/succeeded login & signup attempts, keyed by the submitted email —
// not a FK to User, so we can rate-limit attempts against emails that don't
// exist yet without leaking that distinction via timing or errors.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// FIXED_DAYS habits are due on specific weekdays (1=Monday..7=Sunday, ISO) —
// checked off from "Hoy". QUOTA habits just need N completions within the
// period, any days; checked off from "Hábitos" since there's no single "due" day.
model Habit {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  recurrenceType RecurrenceType
  weekdays       Int[]           @default([])
  quotaPeriod    QuotaPeriod?
  quotaTarget    Int?
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  logs           HabitLog[]
  pauses         HabitPause[]

  @@index([userId, archivedAt])
}

// A habit can be paused/resumed repeatedly; each window is recorded so past
// calendar days stay correctly marked "not scheduled" even after resuming.
// toDate null = pause still active. userId is denormalized from Habit so
// every query can filter by owner directly, without a join, as a second
// line of defense against cross-user access.
model HabitPause {
  id       String   @id @default(cuid())
  habitId  String
  habit    Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDate String
  toDate   String?

  @@index([habitId])
  @@index([userId])
}

// date is "YYYY-MM-DD" in the app timezone — avoids DST/UTC-boundary bugs,
// since we only ever compare calendar days, not instants. One row per
// completion date regardless of habit type (FIXED_DAYS or QUOTA). userId is
// denormalized from Habit, same reasoning as HabitPause.
model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId])
  @@index([userId])
}

model Task {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  title     String
  time      String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// One entry per day, entered from "Hoy", surfaced with history/graph on "Peso".
model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  weightKg  Float
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

// One row per user. gymWeekdays uses the same ISO weekday encoding as
// Habit.weekdays (1=Monday..7=Sunday) — which days the user trains at all,
// independent of which routine runs on each of those days (see Routine.weekdays).
model Settings {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone     String @default("Europe/Madrid")
  gymWeekdays  Int[]  @default([])
}

// ---- Gimnasio ----

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  GLUTES
  CORE
  FOREARMS
  FULL_BODY
  OTHER
}

enum Equipment {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  BAND
  OTHER
}

enum SetType {
  WARMUP
  NORMAL
  TOP_SET
  BACK_OFF
}

enum WorkoutStatus {
  IN_PROGRESS
  COMPLETED
}

// Every exercise is created by a user — no predefined/global library.
// Exercises are only ever archived, never hard-deleted — RoutineExercise and
// WorkoutExercise both reference Exercise with onDelete: Restrict as a
// safety net, so historical sets can never be orphaned by a deletion.
model Exercise {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  primaryMuscle    MuscleGroup
  secondaryMuscles MuscleGroup[] @default([])
  equipment        Equipment     @default(OTHER)
  instructions     String?
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())

  routineExercises RoutineExercise[]
  workoutExercises WorkoutExercise[]

  @@index([userId, archivedAt])
}

// A reusable template. Deleting/editing a routine never touches past
// WorkoutSessions — those hold their own WorkoutExercise/SetEntry rows that
// don't reference RoutineExercise at all (see WorkoutSession below).
// weekdays: which day(s) this routine runs on (1=Monday..7=Sunday, same
// encoding as Habit.weekdays). Enforced in application code to be exclusive
// — assigning a day to one routine clears it from any other.
model Routine {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  weekdays    Int[]     @default([])
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  exercises       RoutineExercise[]
  workoutSessions WorkoutSession[]

  @@index([userId, archivedAt])
}

// An exercise placed inside a routine, in order. targetRepMin/Max is
// optional and belongs here (not on Exercise) because the same exercise can
// have a different rep target in different routines.
model RoutineExercise {
  id           String   @id @default(cuid())
  routineId    String
  routine      Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order        Int
  targetRepMin Int?
  targetRepMax Int?

  @@index([routineId, order])
  @@index([userId])
}

// One real training session. routineName is a snapshot taken at creation so
// history still reads correctly after the routine is renamed or deleted
// (routineId goes null, routineName stays). Created the moment the user taps
// "Empezar" (status IN_PROGRESS) so progress is durable from the first set,
// not held only in client memory.
model WorkoutSession {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId   String?
  routine     Routine?      @relation(fields: [routineId], references: [id], onDelete: SetNull)
  routineName String
  // "YYYY-MM-DD" in the user's timezone at creation time — same dayKey
  // convention as Habit/Task, used to answer "is there already a session
  // for this routine today" without timezone-sensitive instant-range queries.
  dateKey     String
  status      WorkoutStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  finishedAt  DateTime?

  exercises WorkoutExercise[]

  @@index([userId, startedAt])
  @@index([userId, routineId, dateKey])
}

// One exercise as actually performed within a session. References Exercise
// directly (not RoutineExercise) so it survives any later edit to the
// routine it came from.
model WorkoutExercise {
  id               String         @id @default(cuid())
  workoutSessionId String
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order            Int
  notes            String?

  sets SetEntry[]

  @@index([workoutSessionId, order])
  @@index([userId, exerciseId])
}

model SetEntry {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  order             Int
  weightKg          Float
  reps              Int
  setType           SetType         @default(NORMAL)
  createdAt         DateTime        @default(now())

  @@index([workoutExerciseId, order])
  @@index([userId])
}
